{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/thinkpad.txt",
    // "height": 12,
    "padding": {
      "top": 2,
      "left": 6,
    },
  },
  "display": {
    "color": {
      "keys": "blue",
    },
    "separator": "",
    "constants": [
      "──────────────────────────────────────────────────────", // {$1} - horizontal line for borders
      "\u001b[55D", // {$2} - move cursor left 55 columns
      "\u001b[55C", // {$3} - move cursor right 55 columns
      "\u001b[54C", // {$4} - move cursor right 54 columns
    ],
    "brightColor": true,
  },
  "modules": [
    // "break",
    //        {
    //            "type": "custom",
    //            "key": "                        {#31}┌───────────────────────┐{#keys} \u001b[37D",
    //            "format": ""
    //        },
    //        {
    //            "type": "custom",
    //            "key": "                        {#31}│   {#31}F {#32}A {#33}S {#34}T {#32}F {#36}E {#35}T {#36}C {#31}H   {#31}│",
    //        },
    //        {
    //            "type": "custom",
    //            "key": "                        {#31}└───────────────────────┘{#keys} ",
    //            "format": ""
    //        },
    {
      "type": "custom",
      "key": " {#32}┌─────────────┬{$1}┐{#keys} \u001b[37D",
      "format": "",
    },
    {
      "type": "os",
      "key": " {#32}│ OS          │{$4}│{#keys} {$2}",
    },
    {
      "type": "kernel",
      "key": " {#32}│ Kernel      │{$4}│{#keys} {$2}",
    },
    {
      "type": "de",
      "key": " {#32}│ Desktop     │{$4}│{#keys} {$2}",
    },
    {
      "type": "wm",
      "key": " {#32}│ Session     │{$4}│{#keys} {$2}",
    },
    // {
    //     "type": "packages",
    //     "key": " {#32}│ Packages    │{$4}│{#keys} {$2}"
    // },
    {
      "type": "custom",
      "key": " {#32}└─────────────┴{$1}┘{#keys} ",
      "format": "",
    },
    {
      "type": "custom",
      "key": " {#34}┌─────────────┬{$1}┐{#keys} \u001b[37D",
      "format": "",
    },
    {
      "type": "host",
      "key": " {#34}│ Machine     │{$4}│{#keys} {$2}",
    },
    {
      "type": "display",
      "key": " {#34}│ Display     │{$4}│{#keys} {$2}",
    },
    {
      "type": "cpu",
      "key": " {#34}│ CPU         │{$4}│{#keys} {$2}",
      "format": "{name} @{freq-max}",
      "showPeCoreCount": false,
    },
    {
      "type": "gpu",
      "key": " {#34}│ GPU         │{$4}│{#keys} {$2}",
    },
    //        {
    //            "type": "vulkan",
    //            "key": " {#34}│ GFX         │{$4}│{#keys} {$2}"
    //        },
    {
      "type": "custom",
      "key": " {#34}└─────────────┴{$1}┘{#keys} ",
      "format": "",
    },

    // Hardware section with cyan color theme
    {
      "type": "custom",
      "key": " {#31}┌─────────────┬{$1}┐{#keys} \u001b[37D",
      "format": "",
    },
    {
      "type": "memory",
      "key": " {#31}│ RAM         │{$4}│{#keys} {$2}",
      // "keyColor": "34",
      "percent": {
        "type": 3, // 3 = show number + bar + percentage
        "green": 30, // <30% is green
        "yellow": 70, // 30-70% is yellow, >70% is red
      },
    },
    {
      "type": "swap",
      "key": " {#31}│ SWAP        │{$4}│{#keys} {$2}",
      // "keyColor": "34",
      "percent": {
        "type": 3, // 3 = show number + bar + percentage
        "green": 30, // <30% is green
        "yellow": 70, // 30-70% is yellow, >70% is red
      },
    },
    {
      "type": "disk",
      "key": " {#31}│ Disk        │{$4}│{#keys} {$2}",
      // "keyColor": "34",
      "percent": {
        "type": 3, // 3 = show number + bar + percentage
        "green": 30, // <30% is green
        "yellow": 70, // 30-70% is yellow, >70% is red
      },
    },
    {
      "type": "custom",
      "key": " {#31}└─────────────┴{$1}┘{#keys} ",
      "format": "",
    },
    {
      "type": "custom",
      "key": " {#34}┌─────────────┬{$1}┐{#keys} \u001b[37D",
      "format": "",
    },
    {
      "type": "shell",
      "key": " {#34}│ Shell       │{$4}│{#keys} {$2}",
    },
    {
      "type": "terminal",
      "key": " {#34}│ Terminal    │{$4}│{#keys} {$2}",
    },
    {
      "type": "terminalfont",
      "key": " {#34}│ Term Font   │{$4}│{#keys} {$2}",
    },
    {
      "type": "custom",
      "key": " {#34}└─────────────┴{$1}┘{#keys} ",
      "format": "",
    },
    // {
    //     "type": "custom",
    //     "key": " {#35}┌─────────────┬{$1}┐{#keys} \u001b[37D",
    //     "format": ""
    // },
    // {
    //     "type": "theme",
    //     "key": " {#35}│ Style       │{$4}│{#keys} {$2}",
    //     "format": "{theme1}"
    // },
    // {
    //     "type": "wmtheme",
    //     "key": " {#35}│ Decor       │{$4}│{#keys} {$2}"
    // },
    // {
    //     "type": "icons",
    //     "key": " {#35}│ Icons       │{$4}│{#keys} {$2}"
    //  },
    // {
    //     "type": "cursor",
    //     "key": " {#35}│ Cursors     │{$4}│{#keys} {$2}"
    // },
    // {
    //     "type": "font",
    //     "key": " {#35}│ System Font │{$4}│{#keys} {$2}"
    // },
    // {
    //     "type": "custom",
    //     "key": " {#35}└─────────────┴{$1}┘{#keys} ",
    //     "format": ""
    // },
    {
      "type": "custom",
      "key": " {#32}┌─────────────┬{$1}┐{#keys} \u001b[37D",
      "format": "{#bright_blue}",
    },
    {
      "type": "uptime",
      "key": " {#32}│ Uptime      │{$4}│{#keys} {$2}",
    },
    // {
    //     "type": "users",
    //     "myselfOnly": true,                               // Only show current user
    //     "key": " {#34}│ Login       │{$4}│{#keys} {$2}"
    // },
    {
      "type": "disk",
      "key": " {#32}│ OS Age      │{$4}│{#keys} {$2}",
      "folders": "/", // Check root filesystem
      "format": "{create-time:10} [{days} days]", // Show creation time and age in days
    },
    {
      "type": "datetime",
      "key": " {#32}│ Fetched     │{$4}│{#keys} {$2}",
      "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty} {timezone-name}",
    },
    {
      "type": "custom",
      "key": " {#32}└─────────────┴{$1}┘{#keys} ",
      "format": "",
    },
    // {
    //     "type": "custom",
    //     "key": " {#35}┌─────────────┬{$1}┐{#keys}\u001b[37D",
    //     "format": ""
    // },
    // {
    //     "type": "wifi",
    //     "key": " {#35}│ Interweb    │{$4}│{#keys} {$2}"
    // },
    // {
    //     "type": "bluetooth",
    //     "key": " {#35}│ Bluetooth   │{$4}│{#keys} {$2}"
    // },
    // {
    //     "type": "custom",
    //     "key": " {#35}└─────────────┴{$1}┘{#keys} ",
    //     "format": ""
    // },
    // {
    //     "type": "custom",
    //     "key": " {#34}┌─────────────┬{$1}┐{#keys}\u001b[37D",
    //     "format": ""
    // },
    // {
    //     "type": "sound",
    //     "key": " {#34}│ Sound       │{$4}│{#keys} {$2}",
    //     "format": "{name:43} ({3})",
    // },
    // {
    //     "type": "camera",
    //     "key": " {#34}│ Webcam      │{$4}│{#keys} {$2}"
    // },
    // {
    //     "type": "custom",
    //     "key": " {#34}└─────────────┴{$1}┘{#keys} ",
    //     "format": ""
    // },
    // {
    //     "type": "custom",
    //     "key": "                        {#31}┌───────────────────────┐{#keys} \u001b[37D",
    //     "format": ""
    // },
    // {
    //     "type": "custom",
    //     "key": "                        {#31}│        {#31}F{#32}l{#33}a{#34}v{#32}o{#36}u{#35}r{#36}s       {#31}│",
    // },
    // {
    //     "type": "custom",
    //     "key": "                        {#31}│  {#37}󰅶 {#36} 󰅶 {#35} 󰅶 {#34} 󰅶 {#33} 󰅶 {#32} 󰅶 {#31} 󰅶  {#31}│",
    // },
    // {
    //     "type": "custom",
    //     "key": "                        {#31}└───────────────────────┘{#keys} ",
    //     "format": ""
    // },

    // End with color palette and line break
    // "break",                                             // Add a blank line
    //"colors"                                             // Display color palette
    //        "break",
  ],
}
